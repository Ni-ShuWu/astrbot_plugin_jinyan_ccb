{
    "blacklist_groups": {
        "description": "不发送禁言嘲讽的群号列表",
        "type": "list",
        "items": {
            "type": "string"
        },
        "default": [],
        "hint": "每行一个群号（纯数字），配置后这些群不会发送嘲讽消息"
    },
    "enable_at_all": {
        "description": "是否 @ 被禁言用户",
        "type": "bool",
        "default": false,
        "hint": "开启后嘲讽消息会 @ 被禁言的那个人"
    },
    "enable_abstract": {
        "description": "启用抽象派文案",
        "type": "bool",
        "default": true,
        "hint": "例如：闭嘴的艺术"
    },
    "enable_meta": {
        "description": "启用元游戏文案",
        "type": "bool",
        "default": true,
        "hint": "例如：请由模型代表发言"
    },
    "enable_short": {
        "description": "启用短句快打文案",
        "type": "bool",
        "default": true,
        "hint": "例如：用户喜提禁言"
    },
    "custom_mode": {
        "description": "嘲讽文案来源模式",
        "type": "string",
        "default": "builtin",
        "options": [
            "builtin",
            "custom",
            "mixed"
        ],
        "labels": [
            "仅内置文案",
            "仅自定义文案",
            "内置 + 自定义混合"
        ],
        "hint": "默认保持原有行为；选择「仅自定义」或「混合」时请在下方填写自定义文案"
    },
    "custom_messages": {
        "description": "自定义嘲讽文案",
        "type": "text",
        "default": "",
        "hint": "每行一条；支持占位符 {user}（被禁言者）、{admin}（操作者）、{duration}（禁言时长）、{model}"
    }
}
