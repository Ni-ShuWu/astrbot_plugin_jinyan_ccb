{
    "blacklist_groups": {
        "description": "不发送禁言嘲讽的群号列表",
        "type": "list",
        "items": {
            "type": "string"
        },
        "default": [],
        "hint": "每行一个群号（纯数字），配置后这些群不会发送嘲讽消息"
    },
    "enable_at_all": {
        "description": "是否 @ 被禁言用户",
        "type": "bool",
        "default": false,
        "hint": "开启后嘲讽消息会 @ 被禁言的那个人"
    },
    "enable_abstract": {
        "description": "启用抽象派文案",
        "type": "bool",
        "default": true,
        "hint": "例如：闭嘴的艺术"
    },
    "enable_meta": {
        "description": "启用元游戏文案",
        "type": "bool",
        "default": true,
        "hint": "例如：请由模型代表发言"
    },
    "enable_short": {
        "description": "启用短句快打文案",
        "type": "bool",
        "default": true,
        "hint": "例如：用户喜提禁言"
    }
}
